---
import { getEntry, render } from 'astro:content';

import ClientLayout from '@/components/layout/ClientLayout';
import PostLayout from '@/components/post/PostLayout.astro';
import { getAllPostIds } from '@/lib/posts';
import Layout from '@/layouts/Layout.astro';

export async function getStaticPaths() {
  return getAllPostIds();
}

const { id } = Astro.params;
const post = await getEntry('blog', id);

if (!post) {
  throw new Error(`Blog post not found: ${id}`);
}

const { Content } = await render(post);
const { title, description, date, image } = post.data;
---

<Layout
  title={`${title} | Petr Rajtslegr`}
  description={description}
  article={true}
  publishedTime={date.toISOString()}
>
  <ClientLayout pathname={`/blog/${id}`} client:load>
    <PostLayout title={title} date={date} image={image}>
      <article class="prose dark:prose-invert max-w-none">
        <Content />
      </article>
    </PostLayout>
  </ClientLayout>
</Layout>
